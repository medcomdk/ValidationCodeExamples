<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Firely.Fhir.Packages" Version="5.0.1" />
      <PackageReference Include="Firely.Fhir.Validation.R4" Version="3.1.0" />
      <PackageReference Include="Hl7.Fhir.R4" Version="6.0.2" />
    </ItemGroup>

    <ItemGroup>
      <None Update="Resources\CareCommunication\1SomeCareCommunicationMsg.xml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Resources\CareCommunication\2AnotherCareCommunicationMsg.xml">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Resources\CareCommunication\3AThirdCareCommunicationMsg.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
      <None Update="Resources\Acknowledgement\Acknowledgement-positive.json">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
